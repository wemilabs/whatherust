{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "whatsapp-web",
  "description": "Lets web.whatsapp.com request native notifications through the settings-aware command.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://web.whatsapp.com"]
  },
  "permissions": [
    "allow-show-notification",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission"
  ]
}
