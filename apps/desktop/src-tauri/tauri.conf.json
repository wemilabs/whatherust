{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhatheRust",
  "version": "0.1.0",
  "identifier": "com.wemilabs.whatherust",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WhatheRust",
        "titleBarStyle": "Transparent",
        "url": "https://web.whatsapp.com",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "windowEffects": { "effects": ["mica"] },
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCQ0QxRDE1OTc1NjQyMDAKUldRQVFsYVhGUjNOVzNJVjlNWmxsc1FTd25XOG5CQVdCdXlMSXU4cFZIdmtHc3JzQVNSSjJRSGkK",
      "endpoints": [
        "https://github.com/wemilabs/whatherust/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
