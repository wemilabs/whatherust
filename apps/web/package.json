{
	"name": "@whatherust/web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node scripts/og.js && vite dev",
		"build": "node scripts/og.js && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations --strategy url baseLocale && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"og": "node scripts/og.js"
	},
	"dependencies": {
		"marked": "^18.1.1",
		"sanitize-html": "^2.18.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/inter": "^5.3.0",
		"@inlang/paraglide-js": "^2.29.1",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22",
		"@types/sanitize-html": "^2.16.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"satori": "^0.63.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
