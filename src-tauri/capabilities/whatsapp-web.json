{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "whatsapp-web",
  "description": "Lets web.whatsapp.com show native notifications through the notification plugin's window.Notification polyfill.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://web.whatsapp.com"]
  },
  "permissions": [
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify"
  ]
}
