{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhatsApp",
  "version": "0.1.0",
  "identifier": "com.wemilabs.whatsapp-desktop-rs",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WhatsApp",
        "titleBarStyle": "Transparent",
        "url": "https://web.whatsapp.com",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "windowEffects": { "effects": ["mica"] },
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
